node_modules/
dist/
.DS_Store
*.local
.vite/

# The native projects are committed: they carry the manifest, plist, icons and signing
# configuration, and they are what gets opened in Xcode and Android Studio. Capacitor ships
# its own .gitignore inside each one for build output. The web assets below are copies of
# dist/ regenerated by `npx cap sync`, so they stay out.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/Pods/
ios/App/build/
DerivedData/

# Generated by scripts/shoot.mjs
shots/

# Generated by scripts/capture.mjs — video is large and regenerable in one command.
# The screenshots are kept: they are what gets uploaded to the store listings, and having the
# exact bytes that were submitted in version control is worth the few megabytes.
marketing/*.webm
marketing/*.mp4
